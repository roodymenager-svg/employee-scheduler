rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && profile().role == 'admin' && profile().active == true;
    }

    function isTeamLeader() {
      return signedIn() && profile().role == 'teamLeader' && profile().active == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /schedulerData/shared {
      allow read: if isAdmin() || isTeamLeader();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isTeamLeader()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reports', 'reportsLastModification'])
        && request.resource.data.reportsLastModification.by == request.auth.token.email
        && request.resource.data.reportsLastModification.source == 'team-leader'
      );
    }
  }
}
