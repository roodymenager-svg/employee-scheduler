{
  "firestore": {
    "database": "(default)",
    "location": "northamerica-northeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      },
      {
        "source": "**/*.mjs",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.xlsx",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/scheduler-clean.html"
      }
    ]
  }
}
